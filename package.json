{
  "name": "insolvgestion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/unit/ai-provider.test.ts tests/unit/api-errors.test.ts tests/unit/cases.test.ts tests/unit/client-auth.test.ts tests/unit/demo-data-safety.test.ts tests/unit/env-validation.test.ts tests/unit/file-validation.test.ts tests/unit/finance.test.ts tests/unit/password.test.ts tests/unit/permissions.test.ts tests/unit/reminders.test.ts tests/unit/request-body.test.ts tests/unit/runtime-limits.test.ts tests/unit/session-policy.test.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:e2e:browser": "playwright test --config=playwright.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:demo": "pnpm db:deploy && pnpm db:seed",
    "db:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "reminders": "node --conditions=react-server --import tsx scripts/run-reminders.ts",
    "env:check": "tsx scripts/check-env.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7",
    "@prisma/client": "7",
    "dotenv": "17",
    "next": "16.4.3",
    "pg": "8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "24",
    "@types/pg": "8",
    "@types/react": "19",
    "@types/react-dom": "19",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prisma": "7.10.1",
    "tsx": "4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.0"
  }
}
